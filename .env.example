# !!! MUHIM: bu fayldagi barcha parol/kalit qiymatlari FAQAT NAMUNA. !!!
# Productionga chiqarishdan oldin JWT_SECRET, POSTGRES_PASSWORD,
# MINIO_ROOT_USER/PASSWORD ni albatta o'zgartiring (masalan: `openssl rand -hex 32`).
# Shu namuna qiymatlar ochiq (public) — o'zgartirilmasa, tizim autentifikatsiyasiz
# buzilishi mumkin.

# PostgreSQL
POSTGRES_DB=etransport
POSTGRES_USER=etransport
POSTGRES_PASSWORD=etransport_secret
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=etransport-files

# API
# Faqat serverning o‘zida: 127.0.0.1:8080 (tarmoqdan yopiq). Tashqi kirish — nginx :80 /api
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
# Productionda Swagger o‘chiq. Kerak bo‘lsa: SWAGGER_ENABLED=true (faqat localhost)
SWAGGER_ENABLED=false
JWT_SECRET=ETransportSuperSecretKey2026Minimum32Chars!
JWT_ISSUER=ETransport
JWT_AUDIENCE=ETransportClient
CORS_ORIGINS=http://localhost,http://localhost:5173

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=/api

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# 1C tarozi (ixtiyoriy bootstrap — asosiy: Admin → API sozlamalari, parol DB da shifrlangan)
# ONEC_SCALES_URL=https://buh64.securelab.uz/buh64/hs/vesii/dannie_po_vesam
# ONEC_SCALES_USER=
# ONEC_SCALES_PASSWORD=

# Markaziy QR Link integratsiyasi
QRLINK_BASE_URL=https://qrlink.sgcc.uz/api/documents/register
QRLINK_VERIFICATION_BASE_URL=https://qrlink.sgcc.uz/verify
QRLINK_SOURCE_SYSTEM=E-TRANPORT
QRLINK_API_KEY=ql_e-tranport_f47f11a234d4409b8e950c5bd7a20bcd
QRLINK_ENABLED=true

